<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net7.0-windows</TargetFramework>
		<IsPackable>false</IsPackable>
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.2.0"/>
		<PackageReference Include="xunit" Version="2.4.1"/>
		<PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="3.1.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\TypeOBasic2d\TypeOBasic2d.csproj"/>
	</ItemGroup>
	<ItemGroup>
		<Reference Include="TypeOCore">
			<HintPath>..\TypeOBasic2d\$(OutDir)TypeOCore.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<None Update="Mock\Resources\Lato-Black.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Mock\Resources\texture.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
    <ItemGroup Label="TypeOModules">
        <ProjectReference Name="TypeOCore" Include="../../typeocore/TypeOCore/TypeOCore.csproj"/>
        <ProjectReference Name="TypeOTK" Include="../../typeotk/TypeOTK/TypeOTK.csproj"/>
        <ProjectReference Name="TypeD" Include="../../typed/TypeD/TypeD.csproj"/>
        <ProjectReference Name="TypeDCore" Include="../../typeocore/TypeDCore/TypeDCore.csproj"/>
    </ItemGroup>
</Project>